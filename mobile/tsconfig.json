{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["./src/*"],
      // The web UI's data layer (src/web/src/lib), shared: see metro.config.js.
      "@web/*": ["../src/web/src/lib/*"]
    }
  },
  "include": ["src", "expo-env.d.ts", ".expo/types/**/*.ts"]
}
