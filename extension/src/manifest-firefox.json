{
  "manifest_version": 3,
  "name": "hunt",
  "version": "0.2.0",
  "description": "The companion browser extension to hunt, the job aplication tracking app",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "19": "icons/19.png",
      "38": "icons/38.png"
    },
    "default_title": "hunt",
    "default_popup": "popup/popup.html",
    "theme_icons": [
      {
        "light": "icons/19-reversed.png",
        "dark": "icons/19.png",
        "size": 19
      },
      {
        "light": "icons/38-reversed.png",
        "dark": "icons/38.png",
        "size": 38
      }
    ]
  },
  "author": "Mosab Ibrahim",
  "homepage_url": "https://careerhunt.app/",
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Open hunt"
    },
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Stash the current page to your Stash, at once"
    }
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "send-to-hunt@careerhunt.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "140.0"
    }
  }
}
