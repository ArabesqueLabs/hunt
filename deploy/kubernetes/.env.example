# hunt's settings: copy to .env. KEY=value, one a line; leave a setting out
# rather than empty.

# Nothing needed for one person's hunt, on SQLite in its volume.
# HUNT_SITE_URL=https://example.com

# `off`: don't ask GitHub for hunt's latest release (for the sidebar's note
# that a newer one is out).
# HUNT_UPDATE_CHECK=off
