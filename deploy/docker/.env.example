# hunt's settings, for compose.yaml beside this file: copy it to .env.
# `docker compose up -d` again after changing them.

# Which hunt: `release` (the latest release), a version to stay on
# (v0.17.0), or `latest` (main's newest build, ahead of any release).
HUNT_VERSION=release

# hunt's owner, who signs in at /login and runs it: their email address
# and password (8 characters or more). Empty: made in hunt's launcher, the
# first time it's opened. Set again, the password replaces theirs: the way
# back in when it's forgotten.
HUNT_ADMIN_EMAIL=
HUNT_ADMIN_PASSWORD=

# Where it listens. 127.0.0.1 keeps it to this computer; 0.0.0.0 opens it
# to your network: make its owner first, and put it behind HTTPS.
HUNT_BIND=127.0.0.1
HUNT_PORT=4848

# PostgreSQL or MySQL instead of SQLite in the volume (make the database
# first): postgres://hunt:secret@db/hunt, or mysql://hunt:secret@db:3306/hunt
HUNT_DB=
